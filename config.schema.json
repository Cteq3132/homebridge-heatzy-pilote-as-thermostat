{
  "pluginAlias": "HeatzyPilote",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "headerDisplay": "Sign in with your Heatzy account to add your devices. Your password is not saved: only a Heatzy token is kept in the config, and the local network passcode of each device in Homebridge storage, so that the plugin can work without Heatzy servers.",
  "schema": {
    "type": "object",
    "properties": {
      "name": { "title": "Name", "type": "string", "default": "Heatzy", "required": true },
      "username": { "title": "Heatzy email", "type": "string" },
      "token": { "title": "Heatzy token", "type": "string", "description": "Given by Heatzy servers when you sign in from the plugin settings" },
      "token_expire_at": { "title": "Token expiry (Unix time, in seconds)", "type": "integer" },
      "devices": {
        "title": "Heaters",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": { "title": "Name", "type": "string", "required": true },
            "did": { "title": "Device ID (did)", "type": "string", "required": true },
            "interval": { "title": "Refresh interval (s)", "type": "integer", "default": 60, "minimum": 5 },
            "fake_temp": { "title": "Fake temperature", "type": "integer", "default": 20, "minimum": 10, "maximum": 38 },
            "temp_unit": { "title": "Temperature unit", "type": "string", "default": "C", "oneOf": [{ "title": "°C", "enum": ["C"] }, { "title": "°F", "enum": ["F"] }] },
            "local": { "title": "Local network control (falls back to Heatzy servers)", "type": "boolean", "default": true },
            "ip": { "title": "Device IP (optional, found automatically)", "type": "string", "format": "ipv4" },
            "trace": { "title": "Trace", "type": "boolean", "default": false }
          }
        }
      }
    }
  }
}
